# General Application Settings
NODE_ENV="development" # Set to 'production' for production deployments
PORT="3000" # Port for the Next.js application to run on

# API Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1" # Base URL for the backend API
API_KEY="your_backend_api_key_here" # API key for server-side requests to the backend (if any)

# Database Configuration (if Next.js API routes interact with a database)
DATABASE_URL="your_database_connection_string_here" # Connection string for your database (e.g., PostgreSQL, MongoDB)

# Authentication Configuration (if user accounts are supported)
NEXT_PUBLIC_AUTH_ENABLED="true" # Set to 'true' to enable authentication features
NEXT_PUBLIC_AUTH_PROVIDER_URL="your_auth_provider_url_here" # URL of the authentication provider (e.g., Auth0, Clerk)
NEXT_PUBLIC_AUTH_CLIENT_ID="your_auth_client_id_here" # Client ID for the authentication provider
AUTH_SECRET="your_auth_secret_here" # Secret for server-side authentication (e.g., NextAuth.js secret)

# Payment Gateway Configuration (for e-commerce functionality)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here" # Public key for Stripe or other payment gateway
STRIPE_SECRET_KEY="your_stripe_secret_key_here" # Secret key for Stripe or other payment gateway (server-side only)
NEXT_PUBLIC_CURRENCY="USD" # Default currency for displaying prices (e.g., USD, EUR)

# Analytics Configuration
NEXT_PUBLIC_ANALYTICS_ID="your_google_analytics_id_here" # ID for Google Analytics or similar tracking service